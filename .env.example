# Copy this file to .env and fill it in, or paste the keys in the dashboard (Settings > Exchanges).
# Never commit .env. Keys are only needed for live trading (Phase 6).
# Create keys with: read + futures trading ON, withdrawals OFF, IP whitelist ON.

# Binance (USDT-M futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bitget (USDT-M futures): the passphrase is the one you chose when creating the key
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# MEXC (futures)
MEXC_API_KEY=
MEXC_API_SECRET=
