# Copy this file to .env and fill it in, or paste the keys in the dashboard (Settings > Exchanges).
# Never commit .env. Keys are only needed for live trading (Phase 6).
# Create keys with: read + futures trading ON, withdrawals OFF, IP whitelist ON.

# Binance (USDT-M futures)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bitget (USDT-M futures): the passphrase is the one you chose when creating the key
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# MEXC (futures)
MEXC_API_KEY=
MEXC_API_SECRET=
# Coinbase (US perpetual-style futures): API key name and the EC private key; paste them in the dashboard
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Phone alerts (ntfy app): install ntfy on the phone and subscribe to this topic (server ntfy.sh). Use a long random
# name: anyone who knows it can read the messages. Test: .venv\Scripts\python -m tradeagent alert-test
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Optional outside monitor (for example a free healthchecks.io check): pinged after every cycle, so you are
# told even when the whole VPS is down
HEALTHCHECK_URL=
